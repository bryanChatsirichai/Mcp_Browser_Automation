{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.1.0",
  "description": "Connects this browser to a local Browser Bridge relay.",
  "minimum_chrome_version": "125",
  "permissions": ["storage", "alarms", "tabs", "tabGroups"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Browser Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}

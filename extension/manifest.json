{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.1.0",
  "description": "Connects this browser to a local Browser Bridge relay.",
  "minimum_chrome_version": "125",
  "permissions": ["storage", "alarms", "tabs", "tabGroups"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Browser Bridge" }
}
